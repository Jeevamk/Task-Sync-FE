# Address of the Taskvane API (the backend project). Used for the "Open live API docs" links.
# No "/" at the end. Set it in your host's environment settings too (e.g. Vercel → Environment Variables).
NEXT_PUBLIC_API_URL=http://localhost:3000

# Google OAuth client ID for the "Sign in with Google" button on /login/.
# Use the SAME client ID as GOOGLE_OAUTH_CLIENT_ID in the API. It is public (no secret here, ever).
# In Google Cloud Console, add this site's address (e.g. http://localhost:3001 and your live address)
# to the client's "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
