  "info": {
    "title": "Taskvane API",
    "description": "Each organization connects its own Trello, Slack and Google Sheet. Log in, create an organization, connect, then add a project.",
    "version": "0.3.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "sync-secret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Sync-Secret",
        "description": "SHEET_SYNC_SECRET (sheet import only)"
      }
    },
    "schemas": {
      "GoogleLoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "ID token from Google Sign-In in the web app"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "DevLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "you@example.com"
          },
          "name": {
            "type": "string",
            "example": "Your Name"
          }
        },
        "required": [
          "email"
        ]
      },
      "CreateOrgDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Dev Team",
            "minLength": 2,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Website Revamp"
          },
          "trelloBoard": {
            "type": "string",
            "example": "new",
            "description": "Board link, short code or ID, or \"new\" to create a fresh board with all the lists"
          },
          "newBoardName": {
            "type": "string",
            "example": "Website Revamp",
            "description": "Only with trelloBoard \"new\": the board name (default: the project name)"
          },
          "trelloWorkspaceId": {
            "type": "string",
            "description": "Only with trelloBoard \"new\": Trello workspace ID to create the board in (default: your default workspace)"
          },
          "sheet": {
            "type": "string",
            "example": "new",
            "description": "Sheet link or ID (shared with the Taskvane service account), or \"new\" to create one in your Drive (needs Connect Google)"
          },
          "newSheetName": {
            "type": "string",
            "example": "Taskvane – Website Revamp",
            "description": "Only with sheet \"new\": the sheet name (default: \"Taskvane – <project name>\")"
          },
          "slackChannelId": {
            "type": "string",
            "example": "new",
            "description": "Channel ID from GET …/slack/channels, or \"new\" to create a public channel"
          },
          "newChannelName": {
            "type": "string",
            "example": "website-revamp",
            "description": "Only with slackChannelId \"new\": the channel name (default: the project name, e.g. \"website-revamp\")"
          },
          "extraLists": {
            "example": [
              "Backlog"
            ],
            "description": "Extra lists created if missing, placed before \"To Do\". Not linked to a status: cards there are not tracked",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lists": {
            "type": "object",
            "description": "Only if your list names differ from: To Do, Assigned, In Progress, Ready for Testing, Completed. Example: { \"IN_PROGRESS\": \"Doing\" }"
          },
          "createMissingLists": {
            "type": "boolean",
            "example": false,
            "description": "true = create any missing lists on the board (in workflow order) instead of failing. Always on for trelloBoard \"new\""
          },
          "settings": {
            "type": "object",
            "description": "Optional project settings"
          }
        },
        "required": [
          "name",
          "trelloBoard",
          "sheet",
          "slackChannelId"
        ]
      },
      "CreateCardDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Fix login button"
          },
          "description": {
            "type": "string",
            "example": "The login button does nothing on Safari. Steps: open /login, click \"Sign in\"."
          },
          "list": {
            "type": "string",
            "example": "To Do",
            "description": "List name on the board. Default: the Assigned list when memberIds are given, otherwise To Do"
          },
          "memberIds": {
            "example": [
              "5f1b2c3d4e5f6a7b8c9d0e1f"
            ],
            "description": "Trello member IDs to assign (from GET …/projects/{projectId}/board-members). They must be on the board",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dueDate": {
            "type": "string",
            "example": "2026-11-20",
            "description": "\"YYYY-MM-DD\" (due at 18:00 India time) or a full time with zone, e.g. \"2026-11-20T10:00:00Z\""
          },
          "labels": {
            "example": [
              "High",
              "Frontend"
            ],
            "description": "Label names that exist on the board",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "position": {
            "type": "string",
            "enum": [
              "top",
              "bottom"
            ],
            "default": "bottom",
            "description": "Where in the list the card goes"
          }
        },
        "required": [
          "title"
        ]
      },
      "CreatedCardDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6734a1b2c3d4e5f6a7b8c9d0"
          },
          "url": {
            "type": "string",
            "example": "https://trello.com/c/AbCd1234"
          },
          "list": {
            "type": "string",
            "example": "To Do"
          },
          "members": {
            "example": [
              "Jeeva M K"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "example": [
              "High",
              "Frontend"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "due": {
            "type": "string",
            "example": "2026-11-20T12:30:00.000Z"
          },
          "note": {
            "type": "string",
            "example": "The card syncs to the sheet and Slack as soon as Trello reports it (a few seconds)"
          }
        },
        "required": [
          "id",
          "url",
          "list",
          "members",
          "labels",
          "note"
        ]
      },
      "TeamMemberDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Athira"
          },
          "email": {
            "type": "string",
            "example": "athira@company.com",
            "description": "Use the same email as their Slack account"
          },
          "role": {
            "type": "string",
            "enum": [
              "DEV",
              "QA",
              "COORDINATOR"
            ]
          },
          "trello": {
            "type": "string",
            "example": "athira123",
            "description": "Trello username (with or without @) or member ID; looked up automatically"
          },
          "slackUserId": {
            "type": "string",
            "example": "U0123456789",
            "description": "Leave empty: found in Slack by email"
          }
        },
        "required": [
          "name",
          "email",
          "role"
        ]
      },
      "ImportRowDto": {
        "type": "object",
        "properties": {
          "rowNumber": {
            "type": "number",
            "example": 5,
            "description": "Row number in the sheet (used in the result)"
          },
          "key": {
            "type": "string",
            "example": "row-7f3a9c",
            "description": "Stable ID of the row (written by the Apps Script), so a row is never created twice. Use a new key for each new card"
          },
          "title": {
            "type": "string",
            "example": "Fix login button"
          },
          "description": {
            "type": "string",
            "example": "The login button does nothing on Safari"
          },
          "list": {
            "type": "string",
            "example": "To Do",
            "description": "List name; empty = Assigned (with an assignee) or To Do"
          },
          "assignee": {
            "type": "string",
            "example": "Jeeva",
            "description": "Team member name or email (needs a Trello username in the team list)"
          },
          "dueDate": {
            "type": "string",
            "example": "2026-12-01",
            "description": "YYYY-MM-DD, due at 18:00 India time"
          },
          "labels": {
            "type": "string",
            "example": "High, Frontend",
            "description": "Comma-separated label names"
          }
        },
        "required": [
          "rowNumber",
          "key",
          "title"
        ]
      },
      "ImportRequestDto": {
        "type": "object",
        "properties": {
          "sheetId": {
            "type": "string",
            "example": "1Qqwr8bXyZ0aBcDeFgHiJkLmNoPqRsTuVwXyZ012345",
            "description": "ID of the Google Sheet linked to the project (the part after /d/ in its link)"
          },
          "editorEmail": {
            "type": "string",
            "example": "coordinator@example.com",
            "description": "Google account of the person who clicked Import; must be a COORDINATOR in the team list"
          },
          "rows": {
            "description": "1 to 100 rows",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportRowDto"
            }
          }
        },
        "required": [
          "sheetId",
          "rows"
        ]
      },
      "ImportRowResult": {
        "type": "object",
        "properties": {
          "rowNumber": {
            "type": "number",
            "example": 5
          },
          "ok": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "already-created",
              "error"
            ],
            "example": "created"
          },
          "cardUrl": {
            "type": "string",
            "example": "https://trello.com/c/AbCd1234"
          },
          "warnings": {
            "example": [
              "label \"Urgent\" not on the board"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "string",
            "example": "Assignee \"Ravi\" is not in the team list"
          }
        },
        "required": [
          "rowNumber",
          "ok",
          "status"
        ]
      },
      "ImportResponseDto": {
        "type": "object",
        "properties": {
          "created": {
            "type": "number",
            "example": 1
          },
          "failed": {
            "type": "number",
            "example": 0
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportRowResult"
            }
          }
        },
        "required": [
          "created",
          "failed",
          "results"
        ]
      }
    }
  }
}
