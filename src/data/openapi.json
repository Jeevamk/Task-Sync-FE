    "/webhooks/sheets/import": {
      "post": {
        "description": "Called by the Apps Script in the Google Sheet. Needs the X-Sync-Secret header (use \"Authorize\" → sync-secret). Each row is handled on its own: a bad row is reported in \"results\" without failing the others. Sending the same \"key\" again never creates a second card.",
        "operationId": "SheetsController_importCards",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Sync-Secret"
          }
        },
        "security": [
          {
            "sync-secret": []
          }
        ],
        "summary": "Create Trello cards from sheet rows",
        "tags": [
          "Sheets"
        ]
      }
    }
